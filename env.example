# Copy to .env files as needed. See backend/.env.example and frontend/.env.local.example.

# --- Backend (FastAPI) ---
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prompts_vault
EXPECTED_DATABASE_NAME=prompts_vault
EXPECTED_DATABASE_SCHEMA=public
JWT_SECRET_KEY=replace-with-a-long-random-string
CORS_ORIGINS=https://prompts-vault.ru,https://www.prompts-vault.ru,http://194.247.183.244
TELEGRAM_BOT_API_KEY=replace-with-a-long-random-string
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
TELEGRAM_LOGIN_REDIRECT_URI=https://prompts-vault.ru/api-proxy/api/v1/auth/telegram/callback
TELEGRAM_REWARD_SIGNING_SECRET=replace-with-a-long-random-string
TELEGRAM_REWARD_MAX_TOKENS=100
TELEGRAM_REWARD_MAX_AGE_HOURS=48
SITE_URL=https://prompts-vault.ru
BILLING_CHECKOUT_SUCCESS_URL=https://prompts-vault.ru/dashboard?billing=success
BILLING_CHECKOUT_CANCEL_URL=https://prompts-vault.ru/plans?billing=cancel
BILLING_PORTAL_RETURN_URL=https://prompts-vault.ru/dashboard
SCENARIO_FREE_DEMO_RUN_CAP=3
SCENARIO_GUEST_IP_DAILY_PROMPT_CAP=12
SCENARIO_GUEST_FINGERPRINT_DAILY_PROMPT_CAP=8
SCENARIO_GUEST_IP_ROTATION_PROMPT_CAP=6
SCENARIO_GUEST_ANTI_ABUSE_WINDOW_HOURS=24
WEB_DEMO_GAME_DAILY_TOKEN_CAP=24
WEB_DEMO_GAME_CHALLENGE_COOLDOWN_MINUTES=720
WEB_DEMO_GAME_GUEST_IP_DAILY_TOKEN_CAP=72
WEB_DEMO_GAME_GUEST_FINGERPRINT_DAILY_TOKEN_CAP=36
WEB_DEMO_GAME_GUEST_FINGERPRINT_WINDOW_MINUTES=10
WEB_DEMO_GAME_GUEST_FINGERPRINT_WINDOW_EVENT_CAP=6
LEGACY_BOT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_aggregator

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=/api-proxy
NEXT_PUBLIC_SITE_URL=https://prompts-vault.ru
NEXT_PUBLIC_AUTH_STATE_COOKIE_NAME=pv_auth_state

# SSR inside Docker: keep the internal API service hostname (see docker-compose.yml)
# API_URL=http://api:8000

# Optional override for non-HTTPS local Docker only. Do not enable on production.
# DOCKER_AUTH_COOKIE_ALLOW_INSECURE=true
