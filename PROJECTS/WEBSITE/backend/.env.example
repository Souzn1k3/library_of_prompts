# Copy to .env and adjust
APP_NAME=Prompts Vault API
# Local dev: DEBUG=true skips strict cookie/JWT checks. Production: DEBUG=false, JWT_SECRET_KEY (32+ chars),
# and AUTH_COOKIE_SECURE=true (HTTPS) or AUTH_COOKIE_ALLOW_INSECURE=true (local HTTP only, never in prod).
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prompts_vault
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_SECONDS=120
REDIS_URL=redis://localhost:6379/0
SLOW_REQUEST_THRESHOLD_MS=700
JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_COOKIE_NAME=pv_access_token
REFRESH_TOKEN_COOKIE_NAME=pv_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Only if DEBUG=false and you use plain http://localhost (not needed when DEBUG=true)
AUTH_COOKIE_ALLOW_INSECURE=false
RATE_LIMIT_TRUST_FORWARDED_FOR=false
LEGACY_BEARER_AUTH_ENABLED=true

# Billing / Stripe
BILLING_MOCK_MODE=true
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:3000/dashboard?billing=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:3000/plans?billing=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:3000/dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
